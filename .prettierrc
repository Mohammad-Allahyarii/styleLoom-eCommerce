{
  "semi": true,
  "singleQuote": true,
  "plugins": [
    "./node_modules/@trivago/prettier-plugin-sort-imports/lib/src/index.js"
  ],
  "importOrder": [
    "^react$",
    "^react-router(-dom)?$",
    "<THIRD_PARTY_MODULES>",
    "^@/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
